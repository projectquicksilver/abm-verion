@import url('https://fonts.googleapis.com/css2?family=Sora:wght@300;400;600;800&family=Oswald:wght@500;700&display=swap');

:root {
  --bottom-bg: #e5f0fa; /* Light blue/grey glossy base */
  --cutout-bg: #111111; /* Dark premium button */
  --accent: #fbbf24;
}

.welcome-screen {
  width: 100%;
  min-height: 100vh;
  background: var(--bottom-bg);
  color: #fff;
  font-family: 'Sora', sans-serif;
  display: flex;
  flex-direction: column;
}

.gif-transition-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: #000;
}

.gif-asset { 
  width: 100%; 
  height: 100%; 
  object-fit: cover; 
}

/* --- HERO SECTION --- */
.hero-section {
  position: relative;
  width: 100%;
  height: 100vh; /* Full viewport height */
  min-height: 850px; /* Increased to ensure enough vertical room for stacked elements */
  background: #000;
  overflow: hidden; /* Contains the image */
}

.carousel-container {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.carousel-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.carousel-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(0,0,0,0.6) 0%,
    rgba(0,0,0,0.2) 40%,
    rgba(0,0,0,0.7) 100%
  );
  z-index: 1;
}

/* --- TOP NAVIGATION --- */
.top-nav {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  padding: 30px 50px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 10;
}

.nav-logo {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  padding: 10px 24px;
  border-radius: 20px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  border: 1px solid rgba(255,255,255,0.4);
}

.nav-logo img {
  height: 60px; /* Increased size as requested */
}

.nav-links {
  display: flex;
  gap: 30px;
}

.glass-strip-nav {
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  padding: 12px 30px;
  border-radius: 30px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 10px 30px rgba(0,0,0,0.2), inset 0 0 15px rgba(255,255,255,0.02);
}

.nav-links a {
  color: #fff;
  text-decoration: none;
  font-size: 0.85rem;
  font-weight: 600;
  letter-spacing: 1.5px;
  transition: color 0.3s, text-shadow 0.3s;
  text-shadow: 0 2px 4px rgba(0,0,0,0.5);
}

.nav-links a:hover { 
  color: var(--accent);
  text-shadow: 0 0 10px rgba(251, 191, 36, 0.5);
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 20px;
}

.lang-selector {
  display: flex;
  align-items: center;
  font-size: 0.9rem;
  font-weight: 600;
  padding: 8px 16px;
  border: 1px solid rgba(255,255,255,0.3);
  border-radius: 20px;
  cursor: pointer;
  transition: background 0.3s;
}

.lang-selector:hover {
  background: rgba(255,255,255,0.1);
}

.menu-btn {
  background: none;
  border: none;
  color: #fff;
  cursor: pointer;
}

/* --- GIANT TYPOGRAPHY --- */
.hero-center-text {
  position: absolute;
  top: 45%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  text-align: center;
  z-index: 5;
  pointer-events: none;
}

.modern-shimmer-title {
  font-family: 'Sora', sans-serif;
  font-weight: 800;
  font-size: clamp(3rem, 7vw, 9rem);
  line-height: 0.85; /* Reduced line-height to remove extra space */
  margin: 0;
  color: #ffffff;
  text-transform: uppercase;
  letter-spacing: -3px; /* Luxury Kerning */
  text-shadow: 0 15px 35px rgba(0,0,0,0.4);
}

.modern-shimmer-title .line-one {
  display: block;
  opacity: 0.95;
}

.modern-shimmer-title .line-two {
  display: block;
}

.shimmer-text {
  background: linear-gradient(
    90deg, 
    #fff 0%, 
    #fff 35%, 
    var(--accent) 50%, 
    #fff 65%, 
    #fff 100%
  );
  background-size: 200% auto;
  color: transparent;
  background-clip: text;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: shine 4s linear infinite;
  filter: drop-shadow(0 0 15px rgba(251, 191, 36, 0.4));
}

@keyframes shine {
  to {
    background-position: 200% center;
  }
}

.centered-cta {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 40px; /* Space between title and button */
  pointer-events: auto; /* Re-enable pointer events since parent hero-center-text disables them */
}

/* --- DYNAMIC OVERLAY TEXT BLOCKS --- */
.hero-panels-wrapper {
  position: absolute;
  bottom: 50px;
  left: 50px;
  right: 50px;
  display: flex;
  justify-content: space-between;
  align-items: flex-end; /* Keeps them bottom-aligned */
  z-index: 5;
  pointer-events: none; /* Let clicks pass through empty space between them */
}

.hero-bottom-left, .hero-bottom-right-text {
  position: relative;
  max-width: 450px;
  pointer-events: auto; /* Re-enable clicks on the panels themselves */
}

.hero-bottom-right-text {
  max-width: 550px; /* Right panel gets more breathing room */
  text-align: right;
}

.glossy-panel {
  background: rgba(20, 20, 25, 0.4);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  padding: 24px 30px;
  border-radius: 24px;
  box-shadow: 0 10px 40px rgba(0,0,0,0.3), inset 0 0 20px rgba(255,255,255,0.05);
  text-align: left;
}

.glossy-panel.right {
  text-align: right;
}

.glossy-panel h3 {
  font-family: 'Oswald', sans-serif;
  color: var(--accent);
  font-size: 1.1rem;
  letter-spacing: 2px;
  text-transform: uppercase;
  margin-bottom: 8px;
}

.glossy-panel h4 {
  font-size: 1.6rem;
  font-weight: 800;
  margin-bottom: 12px;
  color: #fff;
  text-shadow: 0 2px 10px rgba(0,0,0,0.5);
}

.glossy-panel p {
  font-size: 0.95rem;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.85);
  margin: 0;
}

.glossy-panel.right h4 {
  font-size: 1.4rem;
}

.glossy-panel.right p.secondary-desc {
  font-size: 0.85rem;
  color: rgba(255, 255, 255, 0.7);
}

/* --- CAROUSEL POINTERS --- */
.carousel-dots {
  position: absolute;
  bottom: 40px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 12px;
  z-index: 10;
}

.dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  border: 1px solid rgba(0,0,0,0.2);
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
}

.dot:hover {
  background: rgba(255, 255, 255, 0.6);
}

.dot.active {
  background: #fff;
  transform: scale(1.4);
  box-shadow: 0 0 10px rgba(255,255,255,0.8);
}

/* --- BUTTON STYLING & POSITIONING --- */
.hero-action-container {
  position: absolute;
  bottom: 80px; /* Positioned right above the dots (which are at 40px) */
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  z-index: 10;
}

.btn-initiate {
  position: relative;
  background: transparent;
  padding: 0;
  border: none;
  border-radius: 100px;
  cursor: pointer;
  display: flex;
  box-shadow: 0 10px 40px rgba(0,0,0,0.6);
  transition: transform 0.2s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.2s;
  overflow: hidden; /* Clips the spinning edge light to the rounded button shape */
}

.btn-initiate:hover {
  transform: scale(1.08);
  box-shadow: 0 0 40px rgba(236, 72, 153, 0.6), 0 0 80px rgba(59, 130, 246, 0.5); /* Intense color illumination */
}

.btn-initiate:active {
  transform: scale(0.92);
}

/* The Spinning Edge Light */
.edge-light {
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: conic-gradient(from 0deg, transparent 60%, #3b82f6 80%, #fbbf24 100%);
  animation: spinLight 1.5s linear infinite; /* Faster base speed */
  z-index: 0;
  transition: all 0.3s;
  opacity: 0.8;
}

.btn-initiate:hover .edge-light {
  animation: spinLight 0.4s linear infinite; /* Thrilling hyper-speed on hover */
  background: conic-gradient(from 0deg, #3b82f6, #ec4899, #fbbf24, #10b981, #3b82f6); /* Rainbow hyper-glow */
  opacity: 1;
}

@keyframes spinLight {
  100% { transform: rotate(360deg); }
}

/* The Inner Dark Button Base */
.btn-inner {
  position: relative;
  z-index: 1;
  background: rgba(15, 23, 42, 0.85); /* Dark navy core */
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  margin: 3px; /* Slightly wider glow gap */
  border-radius: 100px;
  display: flex;
  align-items: center;
  padding: 20px 45px;
  gap: 15px;
  transition: all 0.3s;
}

.btn-initiate:hover .btn-inner {
  background: rgba(15, 23, 42, 0.3); /* highly transparent to reveal the intense backlight */
  box-shadow: inset 0 0 30px rgba(255, 255, 255, 0.4);
}

.btn-text {
  font-size: 1.25rem;
  font-weight: 700;
  font-family: 'Sora', sans-serif;
  letter-spacing: 2px;
  color: #fff;
  text-transform: uppercase;
  position: relative;
  z-index: 2;
  transition: text-shadow 0.3s;
}

.btn-arrow {
  position: relative;
  z-index: 2;
  margin-left: 12px;
  transition: transform 0.3s, filter 0.3s;
}

.btn-initiate:hover .btn-text {
  text-shadow: 0 0 15px rgba(255,255,255,0.8);
}

.btn-initiate:hover .btn-arrow {
  transform: translateX(8px);
  filter: drop-shadow(0 0 8px #fff);
}

/* --- PROFESSIONAL SUMMIT SECTION --- */
.professional-summit-section {
  background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);
  padding: 100px 80px;
  display: flex;
  flex-direction: column;
  gap: 80px;
  position: relative;
  overflow: hidden;
}

.summit-intro {
  text-align: center;
  max-width: 800px;
  margin: 0 auto;
}

.summit-intro h2 {
  font-family: 'Oswald', sans-serif;
  font-size: 3.5rem;
  font-weight: 700;
  text-transform: uppercase;
  color: #f8fafc;
  margin-bottom: 20px;
  letter-spacing: 1px;
}

.summit-intro p {
  font-size: 1.25rem;
  color: #cbd5e1;
  line-height: 1.6;
  margin: 0;
}

.summit-stats-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: 30px;
  padding: 50px 60px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.2);
}

.s-stat {
  display: flex;
  align-items: center;
  gap: 20px;
  transition: transform 0.3s;
}

.s-stat:hover {
  transform: translateY(-5px);
}

.s-num {
  font-family: 'Oswald', sans-serif;
  font-size: 4.5rem;
  font-weight: 700;
  line-height: 1;
  color: #fbbf24;
}

.star-icon-container {
  display: flex;
  align-items: center;
  height: 100%;
}

.s-details {
  display: flex;
  flex-direction: column;
}

.s-title {
  font-size: 1.2rem;
  font-weight: 800;
  color: #f8fafc;
  text-transform: uppercase;
}

.s-sub {
  font-size: 0.9rem;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.s-line {
  width: 1px;
  height: 60px;
  background: rgba(255,255,255,0.1);
}

/* Features Grid Layout */
.summit-features-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  max-width: 1200px;
  margin: 0 auto;
  width: 100%;
}

.mini-carousel-container {
  position: relative;
  border-radius: 30px;
  overflow: hidden;
  box-shadow: 0 20px 50px rgba(0,0,0,0.3);
  height: 500px;
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.05);
}

.mini-carousel-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  inset: 0;
}

.mini-carousel-caption {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 50px 40px 40px;
  background: linear-gradient(to top, rgba(15,23,42,0.95), transparent);
  display: flex;
  align-items: flex-end;
  gap: 20px;
  z-index: 2;
}

.mini-icon {
  width: 60px;
  height: 60px;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(5px);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1px solid rgba(255,255,255,0.2);
}
.prof-gold { color: #fbbf24; }

.mini-caption-text h3 {
  font-family: 'Oswald', sans-serif;
  font-size: 2rem;
  color: #fff;
  margin-bottom: 5px;
  letter-spacing: 1px;
}

.mini-caption-text p {
  font-size: 1rem;
  color: #cbd5e1;
  margin: 0;
  line-height: 1.4;
}

.features-right-column {
  display: flex;
  flex-direction: column;
  gap: 40px;
  justify-content: center;
}

.feature-box {
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.05);
  padding: 40px;
  border-radius: 30px;
  display: flex;
  align-items: center;
  gap: 30px;
  transition: transform 0.3s, box-shadow 0.3s, background 0.3s;
}

.feature-box:hover {
  transform: translateY(-5px);
  box-shadow: 0 15px 40px rgba(0,0,0,0.3);
  background: rgba(255, 255, 255, 0.06);
}

.f-box-icon {
  width: 80px;
  height: 80px;
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.f-box-icon.prof-blue { color: #38bdf8; }
.f-box-icon.prof-silver { color: #cbd5e1; }

.f-box-text h3 {
  font-family: 'Oswald', sans-serif;
  font-size: 2rem;
  color: #f8fafc;
  margin-bottom: 10px;
  letter-spacing: 1px;
}

.f-box-text p {
  font-size: 1.1rem;
  color: #94a3b8;
  line-height: 1.5;
  margin: 0;
}

/* --- RESPONSIVE BREAKPOINTS --- */

/* Tablet (Large) */
@media (max-width: 1200px) {
  .nav-links { gap: 20px; }
  .nav-links a { font-size: 0.75rem; }
  .hero-center-text h1 { font-size: clamp(4rem, 8vw, 9rem); }
}

/* Tablet (Portrait) */
@media (max-width: 1024px) {
  .nav-links { display: none; }
  .hero-center-text h1 { font-size: 7rem; }
  
  .professional-summit-section { padding: 80px 40px; gap: 60px; }
  .summit-stats-row { flex-wrap: wrap; gap: 40px; justify-content: center; padding: 40px; }
  .s-stat { flex: 0 0 calc(50% - 40px); justify-content: center; }
  .s-line { display: none; }
  
  .summit-features-grid { grid-template-columns: 1fr; gap: 40px; }
  .mini-carousel-container { height: 400px; }
  
  .hero-section { height: 100vh; min-height: 800px; }
  
  /* Restructure panels for tablet using flex wrapper */
  .hero-panels-wrapper {
    bottom: 150px;
    left: 40px;
    right: 40px;
  }
  .hero-bottom-left, .hero-bottom-right-text { 
    max-width: calc(50% - 20px);
  }
}

/* Mobile */
@media (max-width: 768px) {
  .top-nav { padding: 16px; }
  .nav-logo img { height: 40px; } /* Shrink logo slightly more */
  
  .hero-center-text { top: 45%; } /* Pushed far down to meet the boxes */
  .hero-center-text h1 { font-size: 3rem; line-height: 1.1; }
  
  .hero-action-container { bottom: 50px; }
  .btn-initiate { padding: 14px 24px; font-size: 0.95rem; }
  
  /* Make panel mobile friendly - stack them automatically with Flexbox! */
  .hero-panels-wrapper {
    bottom: 160px; /* Pulled up closer to the hero text */
    left: 16px;
    right: 16px;
    flex-direction: column;
    align-items: stretch;
    gap: 10px; /* Tighter gap */
  }
  
  .hero-bottom-left, .hero-bottom-right-text {
    max-width: none;
    text-align: left;
  }
  
  .glossy-panel.right {
    text-align: left;
  }
  
  .glossy-panel {
    padding: 12px 16px; /* Tighter internal padding */
    border-radius: 12px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .glossy-panel h3 { font-size: 1.1rem; margin-bottom: 2px; }
  .glossy-panel h4 { font-size: 1rem; margin-bottom: 6px; }
  .glossy-panel.right h4 { font-size: 1rem; }
  .glossy-panel p { font-size: 0.8rem; line-height: 1.3; }
  
  .carousel-dots { bottom: 15px; }
  
  .professional-summit-section { padding: 60px 20px; gap: 50px; }
  .summit-intro h2 { font-size: 2.5rem; }
  .summit-stats-row { padding: 30px 20px; gap: 30px; }
  .s-stat { flex: 100%; justify-content: flex-start; }
  .s-num { font-size: 3.5rem; }
  
  .summit-features-grid { gap: 40px; }
  .feature-box { flex-direction: column; text-align: center; padding: 30px 20px; }
  .f-box-icon { width: 60px; height: 60px; }
  .f-box-icon svg { width: 30px; height: 30px; }
  .mini-carousel-caption { padding: 30px 20px 20px; flex-direction: column; text-align: center; align-items: center; }
}

@media (max-width: 480px) {
  .hero-center-text h1 { font-size: 3rem; }
}
